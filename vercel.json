{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|pt|sw)",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|pt|sw)/index.html",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|pt|sw)/:slug((?!.*\\.)[^/]+)",
      "destination": "/:lang/:slug.html",
      "permanent": true
    },
    {
      "source": "/:slug((?!.*\\.)(?!en$)(?!es$)(?!pt$)(?!sw$)(?!img$)(?!geo$)[^/]+)",
      "destination": "/:slug.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
